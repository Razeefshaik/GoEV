# Backend environment variables. Set these in Render > goev-backend > Environment.
# (Copy to .env only for local experiments; .env is git-ignored.)
# Nothing here is needed for local `gradlew bootRun`: defaults live in application.yml.

# PostgreSQL connection string, exactly as your provider shows it (Neon, Supabase, Render...).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/goev?sslmode=require

# Redis connection string from Upstash (starts with rediss:// - note the double "s").
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Your Netlify site URL, no trailing slash. Comma-separate several if needed.
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

# Already set by render.yaml - shown here for reference.
GOEV_APP=full
MQTT_ENABLED=false

# ---- Optional / later --------------------------------------------------------
# MQTT for real devices (Raspberry Pi clients). Only used when MQTT_ENABLED=true.
# MQTT_BROKER_URL=ssl://xxxx.s1.eu.hivemq.cloud:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Explicit JDBC settings instead of DATABASE_URL:
# JDBC_DATABASE_URL=jdbc:postgresql://HOST:5432/goev?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# JVM memory flags (tuned for Render's free 512 MB):
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1
